# mock = built-in stand-ins (no GPU/models needed). real = Qwen + Llama Guard.
MODEL_MODE=mock
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DB_PATH=events.db
MAX_REQUEST_BYTES=16384
CHAT_RATE_LIMIT=120
CHAT_RATE_WINDOW_SECONDS=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
MEMBER_USERNAME=member
MEMBER_PASSWORD=
# Optional for single-process local development; set a stable random value for production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=
# Real mode only (backend-side, NEVER in the frontend):
# QWEN_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
# GUARD_MODEL_ID=meta-llama/Llama-Guard-3-1B
# HF_TOKEN=
