# Generation backend: groq (cloud) or local (Transformers).
INFERENCE_MODE=groq

# Required only when INFERENCE_MODE=groq. Never expose this value to clients.
GROQ_API_KEY=
GROQ_MODEL_ID=openai/gpt-oss-20b

# The mandatory local safety classifier used in both inference modes.
LLAMA_GUARD_MODEL_ID=meta-llama/Llama-Guard-3-1B
